#!/bin/sh

# Julia compile wrapper-script for 'compile.sh' (pydomjudge; DOMjudge ships
# none). Like the other interpreted languages, it writes a shell script that
# runs the source with the interpreter.
#
# This script requires that julia is installed in the chroot.

DEST="$1" ; shift
MEMLIMIT="$1" ; shift
MAINSOURCE="${ENTRY_POINT:-$1}"

# Report the entry point, so it can be saved, e.g. for later replay:
if [ -z "$ENTRY_POINT" ]; then
	echo "Info: detected entry_point: $MAINSOURCE"
fi

# Do not allow an interpreter line, which could pass options to julia
if grep -n '^#!' "$MAINSOURCE"; then
	echo "Error: interpreter statement(s) found"
	exit 1
fi

# Write executing script:
cat > "$DEST" <<EOF
#!/bin/sh
# Generated shell-script to execute julia interpreter on source.

# Detect dirname and change dir to find other source files.
if [ "\${0%/*}" != "\$0" ]; then
	cd "\${0%/*}"
fi

# julia needs a HOME for its package depot; the trailing ':' keeps the
# default load path (standard library) after the submission directory.
export HOME="\$PWD" JULIA_LOAD_PATH="\$PWD:"
exec julia "$MAINSOURCE" "\$@"
EOF

chmod a+x "$DEST"

exit 0
